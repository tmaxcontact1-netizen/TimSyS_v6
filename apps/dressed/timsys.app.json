{
  "schemaVersion": 1,
  "id": "dressed",
  "name": "Dress'Ed",
  "uiStandard": { "id": "timsys.application-ui", "version": 1, "required": true },
  "kind": "supervised-child",
  "platform": {
    "protocol": "timsys.application.v1",
    "composition": "independent-domain",
    "contracts": ["health", "evidence", "rules", "jobs", "audit", "insights"],
    "domainOwner": "dressed"
  },
  "applicationRootEnvironment": "DRESSED_APP_ROOT",
  "workingDirectory": ".",
  "environmentDefaults": { "DRESSED_PORT": "8090" },
  "processes": {
    "api": {
      "command": "node",
      "arguments": ["dist/src/entrypoints/api.js"],
      "health": {
        "url": "http://127.0.0.1:${DRESSED_PORT}/api/health",
        "expectedStatus": 200,
        "contract": "timsys.application.v1"
      }
    }
  },
  "shutdown": { "signal": "SIGTERM", "timeoutMilliseconds": 10000 },
  "ownership": {
    "runtime": "dressed",
    "databaseSchema": "dressed",
    "images": "dressed",
    "configuration": "dressed"
  }
}
