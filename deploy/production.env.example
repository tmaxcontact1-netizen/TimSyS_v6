# TimSyS v6 Production Environment Variables
# Copy to .env and fill in secure values

# Authentication secrets (minimum 32 characters)
JWT_SECRET=change-to-32-char-minimum-secret-key-here
REFRESH_TOKEN_SECRET=change-to-32-char-minimum-refresh-secret

# Server configuration
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=./data/timsys.sqlite

# Environment
NODE_ENV=production

# Optional: Email service (for password reset, notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Rate limiting overrides
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
