{
  "schemaVersion": 1,
  "id": "tradeed",
  "name": "Trade'Ed",
  "uiStandard": {
    "id": "timsys.application-ui",
    "version": 1,
    "required": true
  },
  "kind": "supervised-child",
  "platform": {
    "protocol": "timsys.application.v1",
    "composition": "timsys-owned-domain-service",
    "contracts": [
      "health",
      "evidence",
      "rules",
      "jobs",
      "providers",
      "audit",
      "insights"
    ],
    "domainOwner": "timsys"
  },
  "applicationRootEnvironment": "TRADEED_APP_ROOT",
  "workingDirectory": ".",
  "environmentDefaults": {
    "PAPER_DASHBOARD_PORT": "8080",
    "TRADEED_PAPER_PRESET": "all_profiles"
  },
  "processes": {
    "worker": {
      "command": "node",
      "arguments": [
        "dist/src/entrypoints/worker.js"
      ]
    },
    "dashboard": {
      "command": "node",
      "arguments": [
        "dist/src/entrypoints/dashboard.js"
      ],
      "health": {
        "url": "http://127.0.0.1:${PAPER_DASHBOARD_PORT}/api/health",
        "expectedStatus": 200,
        "contract": "timsys.application.v1"
      }
    }
  },
  "shutdown": {
    "signal": "SIGTERM",
    "timeoutMilliseconds": 10000
  },
  "ownership": {
    "runtime": "timsys",
    "database": "tradeed",
    "configuration": "timsys"
  }
}
