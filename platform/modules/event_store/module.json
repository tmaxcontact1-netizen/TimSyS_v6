{
  "name": "event_store",
  "version": "1.0.0",
  "author": "admin",
  "dependencies": ["db", "cache", "auth", "log", "validate", "events"],
  "provides": ["event_store.persist", "event_store.query"],
  "requires": [],
  "components": [],
  "routes": [
    { "path": "/event-store", "method": "GET", "handler": "event_store_list", "auth_required": true, "permissions": ["admin:event_store:read"] },
    { "path": "/event-store/:id", "method": "GET", "handler": "event_store_getById", "auth_required": true, "permissions": ["admin:event_store:read"] },
    { "path": "/event-store/channel/:channel", "method": "GET", "handler": "event_store_getByChannel", "auth_required": true, "permissions": ["admin:event_store:read"] },
    { "path": "/event-store/entity/:entityType/:entityId", "method": "GET", "handler": "event_store_getByEntity", "auth_required": true, "permissions": ["admin:event_store:read"] }
  ],
  "functions": [
    { "name": "event_store_list", "exports": "event_store_list", "params": ["limit", "offset"], "returns": "object[]" },
    { "name": "event_store_getById", "exports": "event_store_getById", "params": ["id"], "returns": "object" },
    { "name": "event_store_getByChannel", "exports": "event_store_getByChannel", "params": ["channel", "limit"], "returns": "object[]" },
    { "name": "event_store_getByEntity", "exports": "event_store_getByEntity", "params": ["entityType", "entityId", "limit"], "returns": "object[]" }
  ],
  "schema": { "tables": ["event_store"], "migrations": ["migrations/001_event_store.sql"] },
  "events": { "publishes": [], "subscribes": [] }
}
