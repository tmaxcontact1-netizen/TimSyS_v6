{
  "name": "app_registry",
  "type": "standard",
  "version": "1.0.0",
  "provides": ["capability:read_apps", "capability:write_apps", "capability:sse_stream"],
  "functions": [
    {"name": "listApps", "exports": "listApps", "params": ["filter"], "returns": "App[]"},
    {"name": "getApp", "exports": "getApp", "params": ["appId"], "returns": "App"},
    {"name": "createApp", "exports": "createApp", "params": ["data"], "returns": "App"},
    {"name": "updateApp", "exports": "updateApp", "params": ["appId", "data"], "returns": "App"},
    {"name": "deleteApp", "exports": "deleteApp", "params": ["appId"], "returns": "boolean"},
    {"name": "getUserSettings", "exports": "getUserSettings", "params": ["userId", "appId", "settingsKey"], "returns": "Object"},
    {"name": "saveUserSettings", "exports": "saveUserSettings", "params": ["userId", "appId", "settingsKey", "value"], "returns": "Object"},
    {"name": "streamNotifications", "exports": "streamNotifications", "params": ["req", "res"], "returns": "void"}
  ],
  "schema": {
    "tables": ["apps", "user_settings"],
    "migrations": ["migrations/001_apps.sql", "migrations/002_user_settings.sql"]
  }
}