{
  "name": "app_registry",
  "version": "1.0.0",
  "author": "internal",
  "dependencies": [
    "auth",
    "db",
    "cache",
    "log",
    "events"
  ],
  "provides": [
    "capability:read_apps",
    "capability:write_apps",
    "capability:sse_stream",
    "capability:read_modules",
    "capability:manage_modules"
  ],
  "requires": [],
  "routes": [
    {
      "path": "/api/apps",
      "method": "GET",
      "handler": "app_registry_listApps",
      "auth_required": false,
      "permissions": []
    },
    {
      "path": "/api/apps/:id",
      "method": "GET",
      "handler": "app_registry_getApp",
      "auth_required": true,
      "permissions": []
    },
    {
      "path": "/api/apps",
      "method": "POST",
      "handler": "app_registry_createApp",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/apps/:id",
      "method": "PATCH",
      "handler": "app_registry_updateApp",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/apps/:id",
      "method": "DELETE",
      "handler": "app_registry_deleteApp",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/users/settings",
      "method": "GET",
      "handler": "app_registry_getUserSettings",
      "auth_required": true,
      "permissions": []
    },
    {
      "path": "/api/users/settings",
      "method": "PUT",
      "handler": "app_registry_saveUserSettings",
      "auth_required": true,
      "permissions": []
    },
    {
      "path": "/api/stream/notifications",
      "method": "GET",
      "handler": "app_registry_streamNotifications",
      "auth_required": false,
      "permissions": []
    },
    {
      "path": "/api/modules",
      "method": "GET",
      "handler": "app_registry_listModules",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/modules/:moduleName/state",
      "method": "POST",
      "handler": "app_registry_setModuleState",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/modules/assign",
      "method": "POST",
      "handler": "app_registry_assignModuleToApp",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/modules/unassign",
      "method": "DELETE",
      "handler": "app_registry_removeModuleFromApp",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    },
    {
      "path": "/api/modules/list-for-app",
      "method": "GET",
      "handler": "app_registry_listModulesForApp",
      "auth_required": true,
      "permissions": [
        "admin:*"
      ]
    }
  ],
  "functions": [
    {
      "name": "app_registry_listApps",
      "exports": "listApps",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_getApp",
      "exports": "getApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_createApp",
      "exports": "createApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_updateApp",
      "exports": "updateApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_deleteApp",
      "exports": "deleteApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_getUserSettings",
      "exports": "getUserSettings",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_saveUserSettings",
      "exports": "saveUserSettings",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_streamNotifications",
      "exports": "streamNotifications",
      "params": [
        "req",
        "res"
      ],
      "returns": "void"
    },
    {
      "name": "app_registry_listModules",
      "exports": "listModules",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_setModuleState",
      "exports": "setModuleState",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_assignModuleToApp",
      "exports": "assignModuleToApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_removeModuleFromApp",
      "exports": "removeModuleFromApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    },
    {
      "name": "app_registry_listModulesForApp",
      "exports": "listModulesForApp",
      "params": [
        "req",
        "ctx"
      ],
      "returns": "Object"
    }
  ],
  "schema": {
    "tables": [
      "apps",
      "user_settings",
      "modules_config",
      "app_modules"
    ],
    "migrations": [
      "migrations/001_apps.sql",
      "migrations/002_user_settings.sql",
      "migrations/003_modules_config.sql",
      "migrations/004_app_modules.sql"
    ]
  },
  "events": {
    "publishes": [
      "app.created",
      "app.updated",
      "app.deleted",
      "module.state_changed"
    ],
    "subscribes": []
  }
}