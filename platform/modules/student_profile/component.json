{
  "name": "student_profile",
  "version": "1.0.0",
  "type": "profile",
  "capabilities": [
    "capability:student_profile.read"
  ],
  "dependencies": ["db", "cache", "auth", "log", "validate", "events"],
  "routes": [
    {
      "path": "/students/:id/profile",
      "method": "GET",
      "handler": "student_profile_getProfile",
      "auth_required": true,
      "permissions": ["admin:students:read"]
    }
  ],
  "functions": [
    {
      "name": "student_profile_getProfile",
      "exports": "getProfile",
      "params": ["id"],
      "returns": "StudentProfile"
    }
  ],
  "schema": {},
  "events": {
    "publishes": [],
    "subscribes": []
  }
}