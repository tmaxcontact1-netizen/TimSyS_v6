{
  "name": "gradebook_workspace",
  "version": "1.0.0",
  "author": "admin",
  "dependencies": ["db", "cache", "auth", "log", "validate", "events"],
  "provides": ["capability:gradebook.workspace.read", "capability:gradebook.reporting_periods.resolve"],
  "requires": ["capability:gradebook.instances.read", "capability:academic_structure.read", "capability:assessment_evidence.read", "capability:grade_evaluation.read"],
  "routes": [
    {"path":"/gradebooks/:id/reporting-periods","method":"GET","handler":"gradebook_workspace_reportingPeriods","auth_required":true,"permissions":["admin:gradebook:read"]},
    {"path":"/gradebooks/:id/workspace","method":"GET","handler":"gradebook_workspace_read","auth_required":true,"permissions":["admin:gradebook:read"]}
  ],
  "schema": {"tables":[],"migrations":[]},
  "events": {"publishes":[],"subscribes":[]},
  "functions": [
    {"name":"gradebook_workspace_reportingPeriods","exports":"reportingPeriods"},
    {"name":"gradebook_workspace_read","exports":"read"}
  ]
}
