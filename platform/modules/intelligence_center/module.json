{
  "name":"intelligence_center","version":"1.0.0","author":"TimSyS","dependencies":["db","auth","log"],
  "provides":["capability:intelligence.providers","capability:intelligence.products","capability:intelligence.metrics"],"requires":[],
  "routes":[
    {"path":"/intelligence/providers","method":"GET","handler":"intelligence_center_listProviders","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/providers/:id/run","method":"POST","handler":"intelligence_center_runProvider","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/products","method":"GET","handler":"intelligence_center_listProducts","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/portfolio","method":"GET","handler":"intelligence_center_portfolio","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/health","method":"GET","handler":"intelligence_center_engineHealth","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/products/:id/actions","method":"POST","handler":"intelligence_center_actOnProduct","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/metrics/:id","method":"GET","handler":"intelligence_center_metricSeries","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/products/:id/decisions","method":"POST","handler":"intelligence_center_decide","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/actions","method":"POST","handler":"intelligence_center_createAction","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/actions","method":"GET","handler":"intelligence_center_listActions","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/actions/:id","method":"PUT","handler":"intelligence_center_updateAction","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/reminders/generate","method":"POST","handler":"intelligence_center_generateReminders","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/outcomes","method":"POST","handler":"intelligence_center_recordOutcome","auth_required":true,"permissions":["admin:*"]},
    {"path":"/intelligence/outcomes/:id/assess","method":"POST","handler":"intelligence_center_assessOutcome","auth_required":true,"permissions":["admin:*"]}
  ],
  "functions":[
    {"name":"intelligence_center_listProviders","exports":"listProviders","params":[],"returns":"Provider[]"},
    {"name":"intelligence_center_runProvider","exports":"runProvider","params":["id","period","scope"],"returns":"ProviderRun"},
    {"name":"intelligence_center_listProducts","exports":"listProducts","params":["scope"],"returns":"InsightProduct[]"},
    {"name":"intelligence_center_portfolio","exports":"portfolio","params":["scope"],"returns":"InsightPortfolio"},
    {"name":"intelligence_center_engineHealth","exports":"engineHealth","params":[],"returns":"IntelligenceHealth"},
    {"name":"intelligence_center_actOnProduct","exports":"actOnProduct","params":["id","action"],"returns":"boolean"},
    {"name":"intelligence_center_metricSeries","exports":"metricSeries","params":["id","scope","period"],"returns":"MetricPoint[]"},
    {"name":"intelligence_center_decide","exports":"decide","params":["id","decision"],"returns":"Decision"},
    {"name":"intelligence_center_createAction","exports":"createAction","params":["action"],"returns":"Action"},
    {"name":"intelligence_center_listActions","exports":"listActions","params":["filter"],"returns":"Action[]"},
    {"name":"intelligence_center_updateAction","exports":"updateAction","params":["id","changes"],"returns":"Action"},
    {"name":"intelligence_center_generateReminders","exports":"generateReminders","params":[],"returns":"InsightProduct[]"},
    {"name":"intelligence_center_recordOutcome","exports":"recordOutcome","params":["outcome"],"returns":"Outcome"},
    {"name":"intelligence_center_assessOutcome","exports":"assessOutcome","params":["id","metricComparison"],"returns":"Assessment"}
  ],
  "schema":{"tables":["provider_runs","metric_definitions","metric_points","insight_products","insight_actions"],"migrations":[]},
  "events":{"publishes":[],"subscribes":[]}
}
