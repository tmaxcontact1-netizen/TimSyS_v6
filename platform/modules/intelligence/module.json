{
  "name": "intelligence",
  "version": "1.0.0",
  "author": "admin",
  "dependencies": ["db", "cache", "auth", "log", "validate", "events"],
  "provides": ["intelligence.synthesize", "intelligence.metadata", "intelligence.rules"],
  "requires": [],
  "components": [],
  "routes": [
    { "path": "/intelligence/synthesize", "method": "POST", "handler": "intelligence_synthesize", "auth_required": true, "permissions": ["admin:intelligence:read"] },
    { "path": "/intelligence/insights/:scopeType/:scopeId", "method": "GET", "handler": "intelligence_getInsights", "auth_required": true, "permissions": ["admin:intelligence:read"] },
    { "path": "/intelligence/metadata/:entityType/:entityId", "method": "GET", "handler": "intelligence_getMetadata", "auth_required": true, "permissions": ["admin:intelligence:read"] },
    { "path": "/intelligence/metadata/:entityType/:entityId", "method": "POST", "handler": "intelligence_storeMetadata", "auth_required": true, "permissions": ["admin:intelligence:write"] },
    { "path": "/intelligence/rules", "method": "POST", "handler": "intelligence_registerRule", "auth_required": true, "permissions": ["admin:intelligence:write"] },
    { "path": "/intelligence/rules", "method": "GET", "handler": "intelligence_listRules", "auth_required": true, "permissions": ["admin:intelligence:read"] },
    { "path": "/intelligence/rules/:id", "method": "DELETE", "handler": "intelligence_deleteRule", "auth_required": true, "permissions": ["admin:intelligence:write"] }
  ],
  "functions": [
    { "name": "intelligence_synthesize", "exports": "intelligence_synthesize", "params": ["options"], "returns": "object" },
    { "name": "intelligence_getInsights", "exports": "intelligence_getInsights", "params": ["scopeType", "scopeId"], "returns": "object[]" },
    { "name": "intelligence_getMetadata", "exports": "intelligence_getMetadata", "params": ["entityType", "entityId"], "returns": "object" },
    { "name": "intelligence_storeMetadata", "exports": "intelligence_storeMetadata", "params": ["entityType", "entityId", "data"], "returns": "string" },
    { "name": "intelligence_registerRule", "exports": "intelligence_registerRule", "params": ["name", "conditions", "actions", "priority"], "returns": "string" },
    { "name": "intelligence_listRules", "exports": "intelligence_listRules", "params": ["enabledOnly"], "returns": "object[]" },
    { "name": "intelligence_deleteRule", "exports": "intelligence_deleteRule", "params": ["ruleId"], "returns": "void" }
  ],
  "schema": { "tables": [], "migrations": [] },
  "events": { "publishes": [], "subscribes": [] }
}
