{
  "name": "room_registry",
  "version": "1.0.0",
  "author": "admin",
  "dependencies": [
    "db",
    "cache",
    "auth",
    "log",
    "validate",
    "events"
  ],
  "provides": [
    "capability:room.read",
    "capability:room.write",
    "capability:room_availability.read"
  ],
  "requires": [],
  "statusConfig": {
    "table": "rooms",
    "altIdField": "room_number",
    "statusField": "status",
    "withdrawnValue": "blocked",
    "activeValue": "available",
    "entityType": "Room",
    "moduleName": "room_registry"
  },
  "routes": [
    {
      "path": "/rooms",
      "method": "GET",
      "handler": "room_registry_listRooms",
      "auth_required": true,
      "permissions": [
        "admin:rooms:read"
      ]
    },
    {
      "path": "/rooms",
      "method": "POST",
      "handler": "room_registry_createRoom",
      "auth_required": true,
      "permissions": [
        "admin:rooms:write"
      ]
    },
    {
      "path": "/rooms/:id",
      "method": "GET",
      "handler": "room_registry_readRoom",
      "auth_required": true,
      "permissions": [
        "admin:rooms:read"
      ]
    },
    {
      "path": "/rooms/:id",
      "method": "PUT",
      "handler": "room_registry_updateRoom",
      "auth_required": true,
      "permissions": [
        "admin:rooms:write"
      ]
    },
    {
      "path": "/rooms/:id/withdraw",
      "method": "PUT",
      "handler": "room_registry_withdraw",
      "auth_required": true,
      "permissions": [
        "admin:rooms:write"
      ]
    },
    {
      "path": "/rooms/:id/reinstate",
      "method": "PUT",
      "handler": "room_registry_reinstate",
      "auth_required": true,
      "permissions": [
        "admin:rooms:write"
      ]
    },
    {
      "path": "/rooms/:id/permanent",
      "method": "DELETE",
      "handler": "room_registry_permanentDelete",
      "auth_required": true,
      "permissions": [
        "admin:rooms:delete"
      ]
    },
    {
      "path": "/rooms/:id/bookings",
      "method": "GET",
      "handler": "room_registry_listBookings",
      "auth_required": true,
      "permissions": [
        "admin:rooms:read"
      ]
    },
    {
      "path": "/api/rooms/import",
      "method": "POST",
      "handler": "room_registry_importRooms",
      "auth_required": true,
      "permissions": [
        "admin:rooms:write"
      ]
    }
  ],
  "schema": {
    "tables": [
      "rooms",
      "room_bookings"
    ],
    "migrations": [
      "migrations/001_rooms.sql"
    ]
  },
  "events": {
    "publishes": [
      "room.created",
      "room.updated",
      "room.withdrawn",
      "room.reinstated",
      "room.deleted_permanently",
      "room.booked",
      "room.cancelled"
    ],
    "subscribes": []
  },
  "functions": [
    {
      "name": "room_registry_listRooms",
      "exports": "listRooms",
      "params": [
        "filter",
        "page",
        "limit"
      ],
      "returns": "Room[]"
    },
    {
      "name": "room_registry_createRoom",
      "exports": "createRoom",
      "params": [
        "data"
      ],
      "returns": "Room"
    },
    {
      "name": "room_registry_readRoom",
      "exports": "readRoom",
      "params": [
        "id"
      ],
      "returns": "Room"
    },
    {
      "name": "room_registry_updateRoom",
      "exports": "updateRoom",
      "params": [
        "id",
        "data"
      ],
      "returns": "Room"
    },
    {
      "name": "room_registry_withdraw",
      "exports": "withdraw",
      "params": [
        "id"
      ],
      "returns": "boolean"
    },
    {
      "name": "room_registry_reinstate",
      "exports": "reinstate",
      "params": [
        "id"
      ],
      "returns": "boolean"
    },
    {
      "name": "room_registry_permanentDelete",
      "exports": "permanentDelete",
      "params": [
        "id"
      ],
      "returns": "boolean"
    },
    {
      "name": "room_registry_listBookings",
      "exports": "listBookings",
      "params": [
        "roomId"
      ],
      "returns": "RoomBooking[]"
    },
    {
      "name": "room_registry_importRooms",
      "exports": "importRooms",
      "params": [
        "csv"
      ],
      "returns": "{inserted, skipped, errors}"
    }
  ]
}
