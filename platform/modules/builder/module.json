{
  "name": "builder",
  "version": "1.0.0",
  "author": "admin",
  "dependencies": [
    "db",
    "cache",
    "auth",
    "log",
    "validate",
    "events"
  ],
  "provides": [
    "capability:builder.dashboard",
    "capability:builder.scaffold"
  ],
  "requires": [],
  "routes": [
    {
      "path": "/builder/dashboard",
      "method": "GET",
      "handler": "builder_dashboard",
      "auth_required": false
    },
    {
      "path": "/builder/new-module",
      "method": "GET",
      "handler": "builder_newModule",
      "auth_required": false
    },
    {
      "path": "/builder/:module/analysis",
      "method": "GET",
      "handler": "builder_analysis",
      "auth_required": false
    },
    {
      "path": "/builder/recommendations",
      "method": "GET",
      "handler": "builder_recommendations",
      "auth_required": false
    },
    {
      "path": "/builder/templates",
      "method": "GET",
      "handler": "builder_templates",
      "auth_required": false
    },
    {
      "path": "/builder/assemble",
      "method": "POST",
      "handler": "builder_assemble",
      "auth_required": false
    },
    {
      "path": "/builder/components",
      "method": "GET",
      "handler": "builder_components",
      "auth_required": false
    },
    {
      "path": "/builder/compose",
      "method": "POST",
      "handler": "builder_compose",
      "auth_required": false
    },
    {
      "path": "/builder/validate",
      "method": "POST",
      "handler": "builder_validate",
      "auth_required": false
    },
    {
      "path": "/modules/list-for-app",
      "method": "GET",
      "handler": "builder_modulesForApp",
      "auth_required": true
    },
    {
      "path": "/modules/assign",
      "method": "POST",
      "handler": "builder_assignModule",
      "auth_required": true
    },
    {
      "path": "/modules/unassign",
      "method": "DELETE",
      "handler": "builder_unassignModule",
      "auth_required": true
    },
    {
      "path": "/components/list-for-app",
      "method": "GET",
      "handler": "builder_componentsForApp",
      "auth_required": true
    },
    {
      "path": "/components/assign",
      "method": "POST",
      "handler": "builder_assignComponent",
      "auth_required": true
    },
    {
      "path": "/components/unassign",
      "method": "DELETE",
      "handler": "builder_unassignComponent",
      "auth_required": true
    }
  ],
  "functions": [
    {
      "name": "builder_dashboard",
      "exports": "dashboard",
      "params": [],
      "returns": "any"
    },
    {
      "name": "builder_newModule",
      "exports": "newModule",
      "params": [],
      "returns": "any"
    },
    {
      "name": "builder_analysis",
      "exports": "analysis",
      "params": [],
      "returns": "any"
    },
    {
      "name": "builder_recommendations",
      "exports": "recommendations",
      "params": [],
      "returns": "any"
    },
    {
      "name": "builder_templates",
      "exports": "templates",
      "params": [],
      "returns": "any"
    },
    {
      "name": "builder_assemble",
      "exports": "assemble",
      "params": [
        "spec"
      ],
      "returns": "assembly_result"
    },
    {
      "name": "builder_components",
      "exports": "components",
      "params": [],
      "returns": "component_list"
    },
    {
      "name": "builder_compose",
      "exports": "compose",
      "params": [
        "input"
      ],
      "returns": "composition_result"
    },
    {
      "name": "builder_validate",
      "exports": "validate",
      "params": [
        "input"
      ],
      "returns": "validation_result"
    },
    { "name": "builder_modulesForApp", "exports": "modulesForApp", "params": [], "returns": "module_list" },
    { "name": "builder_assignModule", "exports": "assignModule", "params": [], "returns": "assignment" },
    { "name": "builder_unassignModule", "exports": "unassignModule", "params": [], "returns": "assignment" },
    { "name": "builder_componentsForApp", "exports": "componentsForApp", "params": [], "returns": "component_list" },
    { "name": "builder_assignComponent", "exports": "assignComponent", "params": [], "returns": "assignment" },
    { "name": "builder_unassignComponent", "exports": "unassignComponent", "params": [], "returns": "assignment" }
  ],
  "schema": {
    "tables": [],
    "migrations": []
  },
  "events": {
    "publishes": [],
    "subscribes": [
      "platform.ready"
    ]
  }
}
