{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timsys.application-protocol.v1",
  "title": "TimSyS supervised application protocol",
  "type": "object",
  "required": ["protocol", "application", "status", "observedAt", "components"],
  "properties": {
    "protocol": { "const": "timsys.application.v1" },
    "application": { "type": "string", "minLength": 1 },
    "status": { "enum": ["healthy", "degraded", "blocked", "unavailable"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["healthy", "degraded", "blocked", "unavailable"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
