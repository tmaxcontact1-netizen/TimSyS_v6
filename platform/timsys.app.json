{
  "schemaVersion": 1,
  "id": "timsys-platform",
  "name": "TimSyS Platform",
  "uiStandard": { "id": "timsys.application-ui", "version": 1, "required": true },
  "kind": "supervised-child",
  "applicationRootEnvironment": "TIMSYS_PLATFORM_ROOT",
  "workingDirectory": ".",
  "environmentDefaults": { "NODE_ENV": "production", "PORT": "3000" },
  "processes": {
    "backend": {
      "command": "node",
      "arguments": ["index.js"],
      "health": { "url": "http://127.0.0.1:${PORT}/health", "expectedStatus": 200 }
    }
  },
  "shutdown": { "signal": "SIGTERM", "timeoutMilliseconds": 10000 }
}
