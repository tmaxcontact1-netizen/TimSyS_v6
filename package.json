{
  "name": "timsys-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24.18.0 <25", "npm": ">=11.9.0 <12" },
  "scripts": {
    "install:all": "node scripts/workspace.mjs install",
    "test": "node scripts/workspace.mjs test",
    "build": "node scripts/workspace.mjs build",
    "verify": "node scripts/workspace.mjs verify",
    "fetch:postgres": "node scripts/fetch-postgres.mjs",
    "stage:windows": "node scripts/prepare-windows-runtime.mjs",
    "package:windows": "npm run verify && npm run fetch:postgres && npm run stage:windows && npm --prefix apps/launcher run electron:build"
  }
}
